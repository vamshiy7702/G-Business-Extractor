# Backend
LEADX_DB=leadx.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEADX_MAX_CONCURRENT=1
LEADX_MAX_TILES=400
# REQUIRED for OpenStreetMap servers: a real address so they can contact you if your usage causes problems.
# Placeholder values (example.com) are ignored.
CONTACT_EMAIL=
NOMINATIM_USER_AGENT=LeadExtractor/1.0
NOMINATIM_REFERER=http://localhost:3000/
NOMINATIM_MIN_INTERVAL=1.1

# Google Places API (optional). Keep this server-side.
GOOGLE_PLACES_API_KEY=
# Defaults below reflect Google's current published India pricing for Places API Pro.
# Change them if your billing account uses another pricing region.
GOOGLE_PRICING_REGION=IN
GOOGLE_TEXT_SEARCH_FREE_CAP=35000
GOOGLE_TEXT_SEARCH_PRICE_PER_1000=9.60
GOOGLE_PLACE_DETAILS_FREE_CAP=35000
GOOGLE_PLACE_DETAILS_PRICE_PER_1000=5.10

# Email enrichment
EMAIL_ENRICHMENT_ENABLED=true
EMAIL_TIMEOUT_SECONDS=15
EMAIL_PER_DOMAIN_DELAY=0.75
EMAIL_MAX_CONCURRENCY=4
